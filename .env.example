# ── Copy this file to .env and fill in your real values ──────────────────────
# NEVER commit the real .env file to GitHub

# Render PostgreSQL database URL (auto-set by Render when you add a database)
DATABASE_URL=postgresql://username:password@hostname:5432/dbname

# Set to "production" on Render, "development" locally
NODE_ENV=production

# ── Admin portal password ─────────────────────────────────────────────────────
# Choose a strong password — this protects your admin dashboard
ADMIN_PASSWORD=PVGTadmin@Success10

# ── Email / SMTP settings ─────────────────────────────────────────────────────
# Use your pro email host settings from Porkbun or your email provider
SMTP_HOST=smtp.zoho.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=team@parahvineglobaltech.com
SMTP_PASS=your_email_password_here
